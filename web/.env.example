# Comfy Developer Platform — https://platform.comfy.org/profile/api-keys
COMFY_API_KEY=
# Where the LTX Layout-To-Render workflow runs (Comfy SDK): a Comfy deployment URL, or a local ComfyUI behind
# comfy-api-proxy (e.g. http://127.0.0.1:8189). Leave empty to use Comfy's default endpoint.
COMFY_BASE_URL=
# Model routing (defaults = best quality path through Comfy Router)
DIRECTOR_MODEL=openai/gpt-6-sol
BUILDER_MODEL=openai/gpt-6-astra
LOOK_MODEL=openai/gpt-image-2.5-sunburst
# Optional local dev route: use your Codex CLI subscription instead of Router for director/builder/look
# (set to "codex"; needs `codex` on PATH and a logged-in account in CODEX_HOME). "claude" (Claude Code CLI) and "agy"
# (Antigravity CLI) work the same way for planning and building; the look still then comes from a route with images.
LLM_PROVIDER=router
CODEX_HOME=
CODEX_MODEL=gpt-6.1-terra

# Optional: OpenAI API with your own key, for models Comfy Router does not carry yet (gpt-6.1-terra).
# OPENAI_API_KEY=
# Optional: your own Anthropic key (Claude models, text) and Google Gemini key (Gemini text + image models)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Optional: any OpenAI-compatible model server — your own (Ollama http://127.0.0.1:11434/v1, vLLM, LM Studio,
# llama.cpp) or a hosted open-weights provider; the key only if the server needs one.
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

